# =============================================================================
# PMSL Terceiros — modelo do arquivo backend/.env
# Copie para backend/.env e preencha. O .env NUNCA deve ir para o Git.
# =============================================================================

# Banco de dados (container pmsl_db)
POSTGRES_USER=pmsl_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=pmsl_db
DATABASE_URL=postgresql://pmsl_user:troque_esta_senha@pmsl_db:5432/pmsl_db

# Segurança da aplicação (gere valores longos e aleatórios, ex.: openssl rand -hex 32)
JWT_SECRET_KEY=
CRON_SECRET_KEY=

# Active Directory (integração para desativar/reativar contas no desligamento)
AD_ENABLED=false
AD_SERVER=
AD_PORT=636
AD_USER=
AD_PASS=
AD_BASE_DN=

# E-mail (SMTP)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_CC_RECIPIENT=
